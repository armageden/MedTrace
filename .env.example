# MedTrace Model Context Protocol (MCP) Configuration — TEMPLATE
#
# Copy to .env (git-ignored) and fill in real values. NEVER commit real secrets.
# Rotate any secret that has ever been committed to a public repository.
#
# Forge side: set the same secret in your Forge app environment
#   forge variables set MEDTRACE_MCP_SECRET "<your-secret>"
# Webtrigger URL: forge webtrigger list <app-id>  (or Developer Console)
MEDTRACE_MCP_SECRET=<your-mcp-secret>
MEDTRACE_WEBTRIGGER_URL=https://<forge-app-id>.hello.atlassian-dev.net/x1/<webtrigger-path>
