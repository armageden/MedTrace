# MedTrace Model Context Protocol (MCP) & Forge Environment Configuration — TEMPLATE
#
# Copy to .env (git-ignored) and fill in real values. NEVER commit real secrets.
# Rotate any secret that has ever been committed to git history (see SECURITY.md).
#
# Forge side (set encrypted Forge variables, then run `forge deploy -e <env>` so Forge snapshots them):
#   forge variables set MEDTRACE_MCP_SECRET "<your-32-byte-hex-secret>" --encrypt -e production
#   forge variables set MEDTRACE_PART11_SECRET "<your-separate-32-byte-hex-secret>" --encrypt -e production
#   (MEDTRACE_PART11_SECRET stays exclusively inside Forge for 21 CFR Part 11 HMAC-SHA256-SEAL-V1
#    signature sealing; never copy MEDTRACE_PART11_SECRET into local developer .env files.)
#
# Forge CLI v15 webtrigger lookup / creation (replace <env> with development, staging, or production):
#   forge webtrigger list -f mcp-sync-webtrigger -e <env>
#   forge webtrigger create -f mcp-sync-webtrigger -e <env>
MEDTRACE_MCP_SECRET=<your-mcp-secret>
MEDTRACE_WEBTRIGGER_URL=https://<your-forge-webtrigger-host>/x1/<webtrigger-path>

# Optional: Permit http:// loopback URLs (localhost, 127.0.0.1, ::1) for local development/testing ONLY.
# Remote http:// URLs are always rejected; keep disabled/unset for production.
# MEDTRACE_ALLOW_INSECURE_LOCALHOST=false

# Optional: Request timeout in milliseconds for Forge webtrigger calls (default: 15000, clamped: 1000..60000).
# MEDTRACE_REQUEST_TIMEOUT_MS=15000
