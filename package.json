{
  "name": "medtrace-backend",
  "version": "1.0.0",
  "description": "MedTrace IEC 62304 & FDA 21 CFR Part 11 Regulatory Compliance Engine",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "pretest": "npm run build",
    "build": "tsc",
    "build:frontend": "npm --prefix static/frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:frontend": "npm --prefix static/frontend run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "lint": "forge lint",
    "lint:manifest": "node scripts/validate-manifest.mjs",
    "test:backend": "npm run build && node --test \"tests/*.test.cjs\"",
    "test:mcp": "node --test tests/mcp-server.test.mjs",
    "test:scripts": "node --test tests/scripts.test.mjs",
    "test": "node --test \"tests/*.test.*\"",
    "test:frontend": "npm --prefix static/frontend test",
    "test:all": "npm test && npm run test:frontend",
    "docs:check": "node scripts/docs-check.mjs",
    "mcp": "node mcp-server/index.mjs"
  },
  "dependencies": {
    "@forge/api": "^5.1.0",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^1.6.0"
  },
  "devDependencies": {
    "@forge/manifest": "^13.8.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  }
}
